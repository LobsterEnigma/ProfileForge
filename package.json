{
  "name": "profileforge",
  "version": "0.1.0",
  "description": "Forge your GitHub profile with animated SVG widgets — starting with a pixel pet that lives on your commits.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "examples": "tsx scripts/examples.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:action": "esbuild src/action/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/action.js --legal-comments=none",
    "site": "esbuild site/app.ts --bundle --format=esm --target=es2022 --outfile=site/app.js --servedir=site --serve=3002",
    "build:site": "esbuild site/app.ts --bundle --minify --format=esm --target=es2022 --outfile=_site/app.js && cp site/index.html _site/index.html"
  },
  "keywords": [
    "github",
    "profile",
    "readme",
    "svg",
    "pixel-art",
    "pet",
    "widget"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
